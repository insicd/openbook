# Copy to docker/openbook.env. Never commit that file or put it in the image.
APP_URL=https://social.example.org
OPENBOOK_DOMAIN=social.example.org
# Generate once: see docs/docker.md. Preserve with database backups.
APP_KEY=
DB_HOST=mysql.example.org
DB_PORT=3306
DB_DATABASE=openbook
DB_USERNAME=openbook
# Single-quote passwords containing $, # or spaces.
DB_PASSWORD=

# Optional: APP_LOCALE=it (default: en); configure MAIL_* for SMTP before opening registrations.
# For file secrets, remove APP_KEY / DB_PASSWORD above and set instead:
# APP_KEY_FILE=/run/secrets/app_key
# DB_PASSWORD_FILE=/run/secrets/db_password
# Also mount those secrets into EACH service in compose.yaml.
