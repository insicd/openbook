APP_NAME=Openbook
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://social.example.org

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Il driver "mysql" copre anche MariaDB. Su shared hosting inserisci qui i
# parametri forniti dal pannello di controllo (cPanel, Plesk, ecc.).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openbook
DB_USERNAME=openbook
DB_PASSWORD=

# Su hosting con limite di nuove connessioni MySQL al secondo (es. Hostinger,
# errore 2002 "Operation not permitted"), impostare true per riusare la
# connessione PDO tra una richiesta e l'altra.
DB_PERSISTENT=false

# Il driver "file" non richiede alcuna tabella di database, quindi funziona
# anche prima di eseguire le migration (installer) e non necessita di Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Impostazioni specifiche di Openbook
# ---------------------------------------------------------------------------

# Nome pubblico e dominio federato dell'istanza. OPENBOOK_DOMAIN deve
# corrispondere all'host usato negli indirizzi utente@dominio e deve
# restare stabile nel tempo: cambiarlo dopo l'avvio rompe la federazione.
OPENBOOK_DOMAIN=social.example.org

# Consente l'esecuzione dei processi periodici (invio/ricezione federazione,
# pulizie) tramite una richiesta HTTP firmata da un token, utile quando
# l'hosting non permette cron job reali o l'accesso SSH.
OPENBOOK_WEB_CRON_ENABLED=false
OPENBOOK_WEB_CRON_TOKEN=

# Notifiche Web Push. Il periodo di grazia lascia al poller del browser il
# tempo di consumare le notifiche quando l'utente e' attivo sul sito. Il TTL
# indica per quanti secondi il push provider puo' trattenere una consegna.
OPENBOOK_PUSH_GRACE_PERIOD=75
OPENBOOK_PUSH_BATCH_SIZE=20
OPENBOOK_PUSH_HTTP_TIMEOUT=5
OPENBOOK_PUSH_TTL=3600

# Limiti media e post (sovrascrivibili dal pannello di amministrazione).
OPENBOOK_MEDIA_MAX_SIZE_KB=8192
OPENBOOK_MEDIA_MAX_ATTACHMENTS=4
OPENBOOK_POST_MAX_LENGTH=5000
OPENBOOK_COMMENT_MAX_LENGTH=2000

# Numero massimo di livelli di risposta mostrati prima del "carica altro".
OPENBOOK_COMMENT_MAX_DEPTH=8

# Numero di post per pagina nel feed.
OPENBOOK_FEED_PER_PAGE=20
# Caratteri di anteprima del testo post nei feed (prima di "Altro...").
OPENBOOK_FEED_BODY_EXCERPT=150

# Ricerca locale per parole chiave (non riguarda utente@dominio).
OPENBOOK_SEARCH_MIN_LENGTH=2
OPENBOOK_SEARCH_PER_SECTION=10
OPENBOOK_MENTION_SUGGEST_MIN_LENGTH=1
OPENBOOK_MENTION_SUGGEST_LIMIT=8

# Bit-length delle chiavi RSA generate per i nuovi Actor ActivityPub.
OPENBOOK_ACTOR_KEY_BITS=2048

# Registrazioni aperte al pubblico (true) oppure solo su invito/approvazione (false).
OPENBOOK_REGISTRATION_OPEN=true
OPENBOOK_REGISTRATION_REQUIRES_APPROVAL=false

# Federazione ActivityPub: firme HTTP e recupero di Actor remoti (Fase 3).
# Non modificare OPENBOOK_FETCH_ALLOW_INSECURE in produzione: consente
# richieste in chiaro verso host remoti soltanto in ambienti di test locali.
OPENBOOK_SIGNATURE_MAX_SKEW=300
OPENBOOK_FETCH_MAX_REDIRECTS=3
OPENBOOK_FETCH_TIMEOUT=10
OPENBOOK_FETCH_ALLOW_INSECURE=false
OPENBOOK_FETCH_SIGNED=true
OPENBOOK_ACTOR_CACHE_TTL_HOURS=24
OPENBOOK_POSTS_CACHE_TTL_HOURS=6
OPENBOOK_REPLIES_CACHE_TTL_HOURS=6
